// Red Candle: browsers get no direct access to the database at all.
// The game's server (Vercel functions, Firebase Admin SDK) is the only reader and
// writer: it replays every run to compute the score and verifies X handles itself.
// Deploy with: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
